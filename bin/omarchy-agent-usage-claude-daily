#!/usr/bin/env python3
"""Add per-day Claude models and the signed-in account to claude.json.

The stock collector keeps a 7-day total and today's model split. The panel
then treats every older day as having no models, so Week shows the same
Opus row as Day. This walks ~/.claude/projects once, caches each file by
mtime and size, and rewrites the usage record in place.
"""

from __future__ import annotations

import json
import os
import sys
import tempfile
from datetime import datetime
from pathlib import Path
from typing import Any


def usage_dir() -> Path:
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state")
    return Path(state) / "omarchy" / "agents" / "usage"


def cache_path() -> Path:
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state")
    return Path(state) / "omarchy" / "agents" / "cache" / "claude-daily.json"


def number(value: Any) -> int:
    try:
        return int(value or 0)
    except (TypeError, ValueError):
        return 0


def local_day(value: Any) -> str:
    if isinstance(value, (int, float)):
        stamp = float(value)
        if stamp > 10_000_000_000:
            stamp /= 1000
        try:
            return datetime.fromtimestamp(stamp).astimezone().date().isoformat()
        except (OSError, OverflowError, ValueError):
            return ""
    text = str(value or "").strip()
    if not text:
        return ""
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        parsed = datetime.fromisoformat(text)
    except ValueError:
        return text[:10] if len(text) >= 10 else ""
    if parsed.tzinfo is not None:
        parsed = parsed.astimezone()
    return parsed.date().isoformat()


def line_tokens(entry: dict[str, Any]) -> tuple[str, str, str, int]:
    message = entry.get("message") if isinstance(entry.get("message"), dict) else {}
    if entry.get("type") != "assistant" and message.get("role") != "assistant":
        return "", "", "", 0
    usage = message.get("usage") or entry.get("usage")
    if not isinstance(usage, dict):
        return "", "", "", 0
    # Claude writes both shapes. Counting every key doubles a record that has both.
    if any(key in usage for key in ("input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")):
        total = (
            number(usage.get("input_tokens"))
            + number(usage.get("output_tokens"))
            + number(usage.get("cache_read_input_tokens"))
            + number(usage.get("cache_creation_input_tokens"))
        )
    else:
        total = (
            number(usage.get("inputTokens"))
            + number(usage.get("outputTokens"))
            + number(usage.get("cacheReadInputTokens"))
            + number(usage.get("cacheCreationInputTokens"))
        )
    if total <= 0:
        return "", "", "", 0
    model = str(message.get("model") or entry.get("model") or "claude")
    day = local_day(entry.get("timestamp") or message.get("timestamp"))
    identity = str(message.get("id") or entry.get("messageId") or entry.get("uuid") or entry.get("requestId") or "")
    return identity, day, model, total


def scan_file(path: Path) -> dict[str, dict[str, int]]:
    days: dict[str, dict[str, int]] = {}
    latest = {}
    with path.open("r", encoding="utf-8", errors="replace") as handle:
        for line_number, line in enumerate(handle, start=1):
            if '"usage"' not in line:
                continue
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            if not isinstance(entry, dict):
                continue
            identity, day, model, total = line_tokens(entry)
            if day and total > 0:
                latest[identity or f"{path}:{line_number}"] = (day, model, total)
    for day, model, total in latest.values():
        bucket = days.setdefault(day, {})
        bucket[model] = bucket.get(model, 0) + total
    return days


def load_cache() -> dict[str, Any]:
    try:
        data = json.loads(cache_path().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {"files": {}}
    if not isinstance(data, dict) or not isinstance(data.get("files"), dict):
        return {"files": {}}
    return data


def save_cache(cache: dict[str, Any]) -> None:
    path = cache_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    write_json(path, cache)


def file_stamp(path: Path) -> tuple[int, int]:
    stat = path.stat()
    return stat.st_mtime_ns, stat.st_size


def daily_models(projects: Path, cache: dict[str, Any]) -> dict[str, dict[str, int]]:
    files = cache.setdefault("files", {})
    seen: set[str] = set()
    combined: dict[str, dict[str, int]] = {}
    if not projects.is_dir():
        return combined
    for path in projects.rglob("*.jsonl"):
        key = str(path)
        seen.add(key)
        try:
            mtime, size = file_stamp(path)
        except OSError:
            continue
        cached = files.get(key) if isinstance(files.get(key), dict) else None
        if (
            cached
            and cached.get("v") == 3
            and cached.get("mtime") == mtime
            and cached.get("size") == size
            and isinstance(cached.get("days"), dict)
        ):
            days = cached["days"]
        else:
            days = scan_file(path)
            files[key] = {"v": 3, "mtime": mtime, "size": size, "days": days}
        for day, models in days.items():
            if not isinstance(models, dict):
                continue
            bucket = combined.setdefault(str(day), {})
            for model, total in models.items():
                bucket[str(model)] = bucket.get(str(model), 0) + number(total)
    for key in list(files):
        if key not in seen:
            files.pop(key, None)
    return combined


def history_rows(days: dict[str, dict[str, int]]) -> list[dict[str, Any]]:
    rows = []
    for day in sorted(days):
        models = days[day]
        rows.append({
            "date": day,
            "messageCount": sum(number(value) for value in models.values()),
            "tokensByModel": models,
        })
    return rows


def claude_account() -> dict[str, str]:
    found = {"accountEmail": "", "accountName": ""}
    path = Path.home() / ".claude.json"
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return found
    account = data.get("oauthAccount") if isinstance(data, dict) else None
    if not isinstance(account, dict):
        return found
    email = str(account.get("emailAddress") or "").strip()
    name = str(account.get("displayName") or "").strip()
    if email:
        found["accountEmail"] = email
    if name:
        found["accountName"] = name
    return found


def write_json(path: Path, payload: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
    tmp = Path(tmp_name)
    try:
        with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, separators=(",", ":"))
            handle.write("\n")
        tmp.chmod(0o600)
        tmp.replace(path)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def apply_daily(record: dict[str, Any], days: dict[str, dict[str, int]]) -> None:
    """One scan feeds the bars and the model rows.

    Stock recentDays and todayTotalTokens stay behind after history is
    rewritten, so the Today bar and TOKENS BY MODEL disagree.
    """
    rows = history_rows(days)
    by_date = {row["date"]: row for row in rows}
    record["history"] = rows
    recent = record.get("recentDays")
    if isinstance(recent, list):
        for entry in recent:
            if not isinstance(entry, dict):
                continue
            found = by_date.get(str(entry.get("date") or ""))
            if found:
                entry["messageCount"] = found["messageCount"]
    today = datetime.now().astimezone().date().isoformat()
    found_today = by_date.get(today)
    record["todayTotalTokens"] = found_today["messageCount"] if found_today else 0
    record["todayTokensByModel"] = found_today["tokensByModel"] if found_today else {}


def enrich(record_path: Path | None = None, projects: Path | None = None) -> bool:
    target = record_path or (usage_dir() / "claude.json")
    try:
        record = json.loads(target.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    if not isinstance(record, dict):
        return False
    cache = load_cache()
    days = daily_models(projects or (Path.home() / ".claude" / "projects"), cache)
    apply_daily(record, days)
    save_cache(cache)
    record.update(claude_account())
    write_json(target, record)
    return True


def main() -> int:
    enrich()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
