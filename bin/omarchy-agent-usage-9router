#!/usr/bin/python3
"""Print the federated 9Router usage record as JSON.

The running local gateway is authoritative because its dashboard endpoints
already merge Local and configured peers such as Railway. The collector uses
the CLI's machine-local auth token and falls back to ~/.9router/db/data.sqlite
when the gateway is unavailable. No credential is written to the usage record.
"""

from __future__ import annotations

import argparse
import calendar
import hashlib
import json
import os
import sqlite3
import subprocess
import sys
import time
from collections import defaultdict
from datetime import date, datetime, timedelta, timezone
from pathlib import Path
from typing import Any
from urllib.error import HTTPError, URLError
from urllib.parse import urlencode
from urllib.request import Request, urlopen

AGENT_ID = "9router"
AGENT_NAME = "9Router"
DEFAULT_BASE_URL = "http://127.0.0.1:20128"
PERIODS = ("today", "7d", "30d", "all")


def router_home() -> Path:
    return Path(os.environ.get("NINEROUTER_HOME") or "~/.9router").expanduser()


def db_path(home: Path | None = None) -> Path:
    return (home or router_home()) / "db" / "data.sqlite"

def cli_token(home: Path | None = None) -> str:
    root = home or router_home()
    try:
        machine_id = (root / "machine-id").read_text().strip()
        secret = (root / "auth" / "cli-secret").read_text().strip()
    except OSError:
        return ""
    if not machine_id or not secret:
        return ""
    raw = (machine_id + "9r-cli-auth" + secret).encode()
    return hashlib.sha256(raw).hexdigest()[:16]

def api_json(path: str, params: dict[str, Any] | None = None, *, token: str | None = None,
             base_url: str | None = None) -> Any:
    auth = token if token is not None else cli_token()
    if not auth:
        raise RuntimeError("9Router CLI token is unavailable")
    base = (base_url or os.environ.get("NINEROUTER_URL") or DEFAULT_BASE_URL).rstrip("/")
    query = "?" + urlencode(params) if params else ""
    request = Request(base + path + query, headers={"x-9r-cli-token": auth, "Accept": "application/json"})
    try:
        with urlopen(request, timeout=8) as response:
            return json.load(response)
    except (HTTPError, URLError, TimeoutError, ValueError) as error:
        raise RuntimeError(f"9Router API unavailable: {error}") from error


def recent_dates(today: date) -> list[str]:
    return [(today - timedelta(days=offset)).isoformat() for offset in range(6, -1, -1)]


def empty_bucket() -> dict[str, int]:
    return {
        "inputTokens": 0,
        "outputTokens": 0,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0,
    }


def add_bucket(target: dict[str, int], inp: int, out: int, cache_read: int, cache_write: int) -> None:
    target["inputTokens"] += inp
    target["outputTokens"] += out
    target["cacheReadInputTokens"] += cache_read
    target["cacheCreationInputTokens"] += cache_write


def number(value: Any) -> int:
    try:
        return max(0, int(value or 0))
    except (TypeError, ValueError):
        return 0


def money(value: Any) -> float:
    try:
        amount = float(value or 0)
    except (TypeError, ValueError):
        return 0.0
    return amount if amount == amount and amount > 0 else 0.0


def day_from_stamp(value: Any) -> str:
    if value is None or value == "":
        return ""
    if isinstance(value, (int, float)):
        stamp = float(value)
        if stamp > 10_000_000_000:
            stamp /= 1000
        try:
            return datetime.fromtimestamp(stamp).astimezone().date().isoformat()
        except (OSError, OverflowError, ValueError):
            return ""
    text = str(value).replace("Z", "+00:00")
    try:
        parsed = datetime.fromisoformat(text)
    except ValueError:
        return ""
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed.astimezone().date().isoformat()


def parse_tokens(raw: Any) -> dict[str, int]:
    data = raw
    if isinstance(raw, str) and raw:
        try:
            data = json.loads(raw)
        except ValueError:
            data = {}
    if not isinstance(data, dict):
        data = {}
    prompt = number(data.get("prompt_tokens") or data.get("input_tokens"))
    completion = number(data.get("completion_tokens") or data.get("output_tokens"))
    cache_read = number(data.get("cached_tokens") or data.get("cache_read_input_tokens"))
    cache_write = number(data.get("cache_creation_input_tokens") or data.get("cache_write_input_tokens"))
    return {
        "prompt": prompt,
        "completion": completion,
        "cache_read": cache_read,
        "cache_write": cache_write,
    }


def empty_stats(today: date) -> dict[str, Any]:
    week = recent_dates(today)
    return {
        "todayPrompts": 0,
        "todaySessions": 0,
        "todayTotalTokens": 0,
        "todayTokensByModel": {},
        "recentDays": [{"date": day, "messageCount": 0} for day in week],
        "history": [],
        "totalPrompts": 0,
        "totalSessions": 0,
        "activeDays": 0,
        "activeDates": [],
        "modelUsage": {},
        "hasLocalStats": True,
        "hasPromptStats": True,
        "todayCost": 0.0,
        "totalCost": 0.0,
        "sources": [],
        "usageOrigin": "local-db",
        "scope": "device",
    }

def source_model_name(row: dict[str, Any], key: str) -> str:
    key_origin = key.split("|", 1)[0] if "|" in key else ""
    origin = str(row.get("origin") or key_origin).strip()
    model = str(row.get("rawModel") or row.get("model") or key.split("|", 1)[-1].split(" (", 1)[0] or "unknown")
    return f"{origin} · {model}" if origin else model

def api_model_usage(stats: dict[str, Any]) -> tuple[dict[str, dict[str, int]], dict[str, int]]:
    models: dict[str, dict[str, int]] = {}
    totals: dict[str, int] = {}
    for key, raw in (stats.get("byModel") or {}).items():
        row = raw if isinstance(raw, dict) else {}
        name = source_model_name(row, str(key))
        prompt = number(row.get("promptTokens"))
        completion = number(row.get("completionTokens"))
        cache_read = number(row.get("cachedTokens"))
        cache_write = number(row.get("cacheCreationTokens"))
        bucket = models.setdefault(name, empty_bucket())
        # 9Router's cachedTokens are a subset of promptTokens, matching the DB
        # collector's convention: cache is split out, never counted twice.
        add_bucket(bucket, max(0, prompt - cache_read - cache_write), completion, cache_read, cache_write)
        totals[name] = totals.get(name, 0) + prompt + completion
    return models, totals

def chart_dates(period: str, chart: list[dict[str, Any]], today: date) -> list[dict[str, Any]]:
    if period == "today":
        day = today.isoformat()
        return [{"date": day, "messageCount": sum(number(point.get("tokens")) for point in chart)}]
    start = today - timedelta(days=(6 if period == "7d" else 29))
    rows = []
    for index, point in enumerate(chart):
        parsed = chart_label_date(str(point.get("label") or ""), today)
        rows.append({
            "date": (parsed or (start + timedelta(days=index))).isoformat(),
            "messageCount": number(point.get("tokens")),
        })
    return rows

def source_summary(stats: dict[str, Any]) -> list[dict[str, Any]]:
    return [{
        "label": str(source.get("label") or ""),
        "available": source.get("available") is True,
        "requests": number(source.get("requests")),
        "tokens": number(source.get("tokens")),
        "error": str(source.get("error") or ""),
    } for source in (stats.get("sources") or []) if isinstance(source, dict)]

def collect_api(fetch=api_json) -> dict[str, Any]:
    today = datetime.now().astimezone().date()
    period_stats: dict[str, dict[str, Any]] = {}
    charts: dict[str, list[dict[str, Any]]] = {}
    api_errors: list[str] = []
    for period in PERIODS:
        try:
            raw = fetch("/api/usage/stats", {"period": period})
            if not isinstance(raw, dict):
                raise RuntimeError(f"invalid {period} stats response")
            period_stats[period] = raw
        except RuntimeError as error:
            api_errors.append(f"stats/{period}: {error}")
        if period != "all":
            try:
                chart = fetch("/api/usage/chart", {"period": period})
                if not isinstance(chart, list):
                    raise RuntimeError(f"invalid {period} chart response")
                charts[period] = chart
            except RuntimeError as error:
                api_errors.append(f"chart/{period}: {error}")

    # Keep every federated result that did arrive. Falling back to the local
    # DB is correct only when no stats endpoint was usable at all.
    if not period_stats:
        raise RuntimeError("all federated stats requests failed")

    today_stats = period_stats.get("today", {})
    week_stats = period_stats.get("7d", {})
    month_stats = period_stats.get("30d", {})
    all_stats = period_stats.get("all", {})
    all_models, _ = api_model_usage(all_stats)
    _, today_models = api_model_usage(today_stats)
    _, week_models = api_model_usage(week_stats)
    _, month_models = api_model_usage(month_stats)

    history_by_date: dict[str, dict[str, Any]] = {
        row["date"]: row for row in chart_dates("30d", charts.get("30d", []), today)
    }
    today_s = today.isoformat()
    history_by_date.setdefault(today_s, {"date": today_s, "messageCount": 0})
    history_by_date[today_s]["tokensByModel"] = today_models
    history_by_date[today_s]["messageCount"] = number(today_stats.get("totalPromptTokens")) + number(today_stats.get("totalCompletionTokens"))
    history_by_date[today_s]["prompts"] = number(today_stats.get("totalRequests"))
    history_by_date[today_s]["sessions"] = 1 if history_by_date[today_s]["prompts"] else 0
    history_by_date[today_s]["cost"] = round(money(today_stats.get("totalCost")), 6)

    week_rows = chart_dates("7d", charts.get("7d", []), today)
    today_hours = [{
        "label": str(point.get("label") or ""),
        "messageCount": number(point.get("tokens")),
        "cost": round(money(point.get("cost")), 6),
        "sources": {
            str(label): number(values.get("tokens"))
            for label, values in (point.get("sources") or {}).items()
            if isinstance(values, dict)
        },
    } for point in charts.get("today", [])]
    return {
        "todayPrompts": number(today_stats.get("totalRequests")),
        "todaySessions": 1 if number(today_stats.get("totalRequests")) else 0,
        "todayTotalTokens": number(today_stats.get("totalPromptTokens")) + number(today_stats.get("totalCompletionTokens")),
        "todayTokensByModel": today_models,
        "recentDays": [dict(row, messageCount=history_by_date[today_s]["messageCount"]) if row["date"] == today_s else row for row in week_rows],
        "history": [history_by_date[key] for key in sorted(history_by_date)],
        "totalPrompts": number(all_stats.get("totalRequests")),
        "totalSessions": sum(1 for row in history_by_date.values() if number(row.get("messageCount")) > 0),
        "activeDays": sum(1 for row in history_by_date.values() if number(row.get("messageCount")) > 0),
        "activeDates": [key for key in sorted(history_by_date) if number(history_by_date[key].get("messageCount")) > 0],
        "modelUsage": all_models,
        "periodTokensByModel": {"day": today_models, "week": week_models, "month": month_models},
        "periodTotals": {kind: number(period_stats.get(raw, {}).get("totalPromptTokens")) + number(period_stats.get(raw, {}).get("totalCompletionTokens"))
            for kind, raw in (("day", "today"), ("week", "7d"), ("month", "30d"), ("total", "all")) if raw in period_stats},
        "todayHours": today_hours,
        "hasLocalStats": True,
        "hasPromptStats": True,
        "todayCost": round(money(today_stats.get("totalCost")), 6),
        "totalCost": round(money(all_stats.get("totalCost")), 6),
        "sources": source_summary(today_stats or all_stats),
        "usageOrigin": "federated-api",
        "apiErrors": api_errors,
        # The API is upstream/federated truth. Multiple synced desktops can
        # observe the same Railway rows, so treating it as device-local would
        # multiply the whole federated total once per snapshot.
        "scope": "account",
    }


def scan_db(path: Path) -> dict[str, Any]:
    models: dict[str, dict[str, int]] = defaultdict(empty_bucket)
    daily_models: dict[str, dict[str, int]] = defaultdict(lambda: defaultdict(int))
    daily_prompts: dict[str, int] = defaultdict(int)
    daily_cost: dict[str, float] = defaultdict(float)
    prompts = 0
    total_cost = 0.0
    try:
        conn = sqlite3.connect(path.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
    except sqlite3.Error:
        return {}
    try:
        conn.row_factory = sqlite3.Row
        conn.execute("PRAGMA query_only = ON")
        try:
            rows = conn.execute(
                "SELECT timestamp, provider, model, promptTokens, completionTokens, cost, tokens FROM usageHistory"
            )
        except sqlite3.Error:
            return {}
        for row in rows:
            day = day_from_stamp(row["timestamp"])
            if not day:
                continue
            parsed = parse_tokens(row["tokens"])
            prompt = parsed["prompt"] or number(row["promptTokens"])
            completion = parsed["completion"] or number(row["completionTokens"])
            cache_read = parsed["cache_read"]
            cache_write = parsed["cache_write"]
            inp = max(0, prompt - cache_read - cache_write)
            total = inp + completion + cache_read + cache_write
            if total <= 0:
                continue
            model = str(row["model"] or "unknown")
            add_bucket(models[model], inp, completion, cache_read, cache_write)
            daily_models[day][model] += total
            daily_prompts[day] += 1
            cost = money(row["cost"])
            daily_cost[day] += cost
            total_cost += cost
            prompts += 1
    finally:
        conn.close()
    return {
        "models": models,
        "daily_models": daily_models,
        "daily_prompts": daily_prompts,
        "daily_cost": daily_cost,
        "prompts": prompts,
        "total_cost": total_cost,
    }


def collect_db(path: Path | None = None) -> dict[str, Any]:
    today = datetime.now().astimezone().date()
    today_s = today.isoformat()
    week = recent_dates(today)
    target = path or db_path()
    scanned = scan_db(target) if target.is_file() else {}
    if not scanned:
        return empty_stats(today)

    history = []
    for day in sorted(set(scanned["daily_models"]) | set(scanned["daily_prompts"])):
        tokens_by_model = dict(scanned["daily_models"][day])
        history.append({
            "date": day,
            "messageCount": sum(tokens_by_model.values()),
            "tokensByModel": tokens_by_model,
            "prompts": scanned["daily_prompts"].get(day, 0),
            "sessions": 1 if scanned["daily_prompts"].get(day, 0) else 0,
            "cost": round(scanned["daily_cost"].get(day, 0.0), 6),
        })

    today_models = dict(scanned["daily_models"].get(today_s, {}))
    by_date = {row["date"]: row["messageCount"] for row in history}
    recent = [{"date": day, "messageCount": by_date.get(day, 0)} for day in week]
    active = [row["date"] for row in history if row["messageCount"] or row["prompts"]]
    today_prompts = scanned["daily_prompts"].get(today_s, 0)
    return {
        "todayPrompts": today_prompts,
        "todaySessions": 1 if today_prompts else 0,
        "todayTotalTokens": sum(today_models.values()),
        "todayTokensByModel": today_models,
        "recentDays": recent,
        "history": history,
        "totalPrompts": scanned["prompts"],
        "totalSessions": len(active),
        "activeDays": len(active),
        "activeDates": active,
        "modelUsage": {model: dict(bucket) for model, bucket in scanned["models"].items()},
        "hasLocalStats": True,
        "hasPromptStats": True,
        "todayCost": round(scanned["daily_cost"].get(today_s, 0.0), 6),
        "totalCost": round(scanned["total_cost"], 6),
        "sources": [{"label": "Local", "available": True, "requests": scanned["prompts"],
                     "tokens": sum(sum(bucket.values()) for bucket in scanned["models"].values()), "error": ""}],
        "usageOrigin": "local-db",
        "scope": "device",
    }

# The three gateways Jcode actually sends traffic to. Each keeps its own
# usage database. The tab is their sum, not the stale sqlite on this PC.
GATEWAYS = (
    ("Hostinger", "http://100.64.49.65:20128", "ssh"),
    ("Railway", "https://9router-production-056a.up.railway.app", "password"),
    ("Sherlocker", "https://ai-router.sherlocker.dev", "password"),
)
GATEWAY_CACHE_SECONDS = 600
STATS_PERIODS = ("today", "7d", "30d", "all")
CHART_PERIODS = ("today", "7d", "30d")

HOSTINGER_JS = r"""
const fs = require("fs");
const crypto = require("crypto");
const http = require("http");
const id = fs.readFileSync("/app/data/machine-id", "utf8").trim();
const secret = fs.readFileSync("/app/data/auth/cli-secret", "utf8").trim();
const token = crypto.createHash("sha256").update(id + "9r-cli-auth" + secret).digest("hex").slice(0, 16);
function get(path) {
  return new Promise((resolve, reject) => {
    const req = http.request({host: "127.0.0.1", port: 20128, path, headers: {"x-9r-cli-token": token, accept: "application/json"}}, (res) => {
      const chunks = [];
      res.on("data", (chunk) => chunks.push(chunk));
      res.on("end", () => {
        const body = Buffer.concat(chunks).toString("utf8");
        if (res.statusCode !== 200) reject(new Error("HTTP " + res.statusCode));
        else resolve(JSON.parse(body));
      });
    });
    req.on("error", reject);
    req.setTimeout(20000, () => req.destroy(new Error("timeout")));
    req.end();
  });
}
(async () => {
  const stats = {};
  const charts = {};
  for (const period of ["today", "7d", "30d", "all"]) stats[period] = await get("/api/usage/stats?period=" + period);
  for (const period of ["today", "7d", "30d"]) charts[period] = await get("/api/usage/chart?period=" + period);
  process.stdout.write(JSON.stringify({stats, charts}));
})().catch((error) => {
  console.error(error.message);
  process.exit(1);
});
"""


def gateway_cache_path() -> Path:
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state")
    return Path(state) / "omarchy" / "agents" / "cache" / "9router-gateways.json"


def blank_stats() -> dict[str, Any]:
    return {
        "totalRequests": 0,
        "totalPromptTokens": 0,
        "totalCompletionTokens": 0,
        "totalCachedTokens": 0,
        "totalCost": 0.0,
        "byModel": {},
        "sources": [],
    }


def add_model(models: dict[str, dict[str, Any]], origin: str, key: str, row: dict[str, Any]) -> None:
    model = str(row.get("rawModel") or key.split("|")[-1] or "unknown")
    merged = models.setdefault(f"{origin}|{model}", {
        "rawModel": model,
        "origin": origin,
        "promptTokens": 0,
        "completionTokens": 0,
        "cachedTokens": 0,
        "requests": 0,
        "cost": 0.0,
    })
    for field in ("promptTokens", "completionTokens", "cachedTokens", "requests"):
        merged[field] = number(merged.get(field)) + number(row.get(field))
    merged["cost"] = float(merged.get("cost") or 0) + money(row.get("cost"))


def combine_gateway_stats(
    payloads: list[tuple[str, dict[str, Any]]],
    errors: list[tuple[str, str]],
) -> tuple[dict[str, dict[str, Any]], dict[str, list[dict[str, Any]]]]:
    """Sum Hostinger, Railway and Sherlocker without dropping a model's origin."""
    stats: dict[str, dict[str, Any]] = {}
    for period in STATS_PERIODS:
        combined = blank_stats()
        for label, payload in payloads:
            raw = ((payload.get("stats") or {}).get(period) or {})
            if not isinstance(raw, dict):
                continue
            combined["totalRequests"] += number(raw.get("totalRequests"))
            combined["totalPromptTokens"] += number(raw.get("totalPromptTokens"))
            combined["totalCompletionTokens"] += number(raw.get("totalCompletionTokens"))
            combined["totalCachedTokens"] += number(raw.get("totalCachedTokens"))
            combined["totalCost"] += money(raw.get("totalCost"))
            for key, row in (raw.get("byModel") or {}).items():
                if isinstance(row, dict):
                    add_model(combined["byModel"], label, str(key), row)
            combined["sources"].append({
                "label": label,
                "available": True,
                "requests": number(raw.get("totalRequests")),
                "tokens": number(raw.get("totalPromptTokens")) + number(raw.get("totalCompletionTokens")),
                "error": "",
            })
        for label, error in errors:
            combined["sources"].append({
                "label": label,
                "available": False,
                "requests": 0,
                "tokens": 0,
                "error": error,
            })
        stats[period] = combined
    charts: dict[str, list[dict[str, Any]]] = {}
    for period in CHART_PERIODS:
        order: list[str] = []
        points: dict[str, dict[str, Any]] = {}
        for _label, payload in payloads:
            for point in ((payload.get("charts") or {}).get(period) or []):
                if not isinstance(point, dict):
                    continue
                label = str(point.get("label") or "")
                if label not in points:
                    order.append(label)
                    points[label] = {"label": label, "tokens": 0, "cost": 0.0}
                points[label]["tokens"] += number(point.get("tokens"))
                points[label]["cost"] += money(point.get("cost"))
        ordered = [points[label] for label in order]
        if period in ("7d", "30d"):
            today = datetime.now().astimezone().date()
            dated = []
            for label in order:
                parsed = chart_label_date(label, today)
                if parsed is None:
                    dated = []
                    break
                dated.append((parsed, points[label]))
            if dated:
                dated.sort(key=lambda item: item[0])
                ordered = [point for _parsed, point in dated]
        charts[period] = ordered
    return stats, charts


def jcode_api_key(label: str) -> str:
    """The same key Jcode already uses for this gateway. Never log the value."""
    slug = label.lower()
    wanted = f"JCODE_9ROUTER_{label.upper()}_API_KEY"
    paths = (
        Path.home() / ".config/jcode" / f"provider-9router-{slug}.env",
        Path.home() / ".jcode" / f"provider-9router-{slug}.env",
    )
    for path in paths:
        if not path.is_file():
            continue
        fallback = ""
        for line in path.read_text(encoding="utf-8").splitlines():
            if not line.strip() or line.strip().startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            value = value.strip().strip('"').strip("'")
            if not value:
                continue
            if key.strip() == wanted:
                return value
            if "API_KEY" in key and not fallback:
                fallback = value
        if fallback:
            return fallback
    return ""


def fetch_with_jcode_key(base: str, key: str) -> dict[str, Any]:
    from urllib.request import Request
    headers = {
        "Authorization": "Bearer " + key,
        "Accept": "application/json",
        "User-Agent": "omarchy-agents",
    }

    def get(path: str) -> Any:
        request = Request(base + path, headers=headers)
        with urlopen(request, timeout=30) as response:
            body = response.read()
        if not body or body[:1] not in (b"{", b"["):
            raise RuntimeError("resposta não é JSON")
        return json.loads(body)

    prefix = ""
    last = "chave do jcode não leu o uso"
    for candidate in ("/api/v1/usage", "/api/usage", "/v1/usage"):
        try:
            get(f"{candidate}/stats?period=all")
        except HTTPError as error:
            last = f"usage HTTP {error.code}"
            continue
        except (URLError, TimeoutError, ValueError):
            last = "usage sem resposta"
            continue
        prefix = candidate
        break
    if not prefix:
        raise RuntimeError(last)
    stats = {period: get(f"{prefix}/stats?period={period}") for period in STATS_PERIODS}
    charts: dict[str, list[Any]] = {}
    for period in CHART_PERIODS:
        try:
            chart = get(f"{prefix}/chart?period={period}")
        except (HTTPError, URLError, TimeoutError, ValueError):
            chart = []
        charts[period] = chart if isinstance(chart, list) else []
    return {"stats": stats, "charts": charts}


def session_when(value: Any) -> datetime | None:
    text = str(value or "").strip()
    if not text:
        return None
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        parsed = datetime.fromisoformat(text)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        return parsed.astimezone()
    return parsed.astimezone()


def session_day(value: Any) -> str:
    parsed = session_when(value)
    if parsed is not None:
        return parsed.date().isoformat()
    text = str(value or "")
    return text[:10] if len(text) >= 10 else ""


def chart_day_label(day: date) -> str:
    """Same English label the 9Router chart route emits, so days sum instead of stacking."""
    return f"{calendar.month_abbr[day.month]} {day.day}"


def chart_label_date(label: str, today: date) -> date | None:
    text = str(label or "").strip()
    if len(text) >= 10 and text[4:5] == "-" and text[7:8] == "-":
        try:
            return date.fromisoformat(text[:10])
        except ValueError:
            return None
    parts = text.split()
    if len(parts) != 2 or not parts[1].isdigit():
        return None
    month = {name: index for index, name in enumerate(calendar.month_abbr) if name}.get(parts[0])
    if not month:
        return None
    try:
        parsed = date(today.year, month, int(parts[1]))
    except ValueError:
        return None
    if parsed > today + timedelta(days=1):
        parsed = parsed.replace(year=today.year - 1)
    return parsed


def jcode_provider_payload(needle: str, root: Path | None = None) -> dict[str, Any]:
    """Token totals already stored on this machine's Jcode sessions for one profile.

    The gateway usage route rejects the same API key Jcode uses to chat. On these
    sessions prompt_tokens equals input_tokens, and cache_read sits inside that
    prompt (almost always a subset). Cache is kept for the tooltip and is not
    added on top of the prompt.
    """
    base = root or (Path.home() / ".jcode" / "sessions")
    now = datetime.now().astimezone()
    today = now.date()
    daily: dict[str, dict[str, int]] = {}
    hourly = [0] * 24
    if base.is_dir():
        marker = needle.encode()
        for path in base.glob("*.json"):
            try:
                raw = path.read_bytes()
            except OSError:
                continue
            if marker not in raw or b'"token_usage"' not in raw:
                continue
            try:
                data = json.loads(raw)
            except ValueError:
                continue
            if needle not in str(data.get("provider_key") or ""):
                continue
            model = str(data.get("model") or "unknown")
            for message in data.get("messages") or []:
                if not isinstance(message, dict):
                    continue
                usage = message.get("token_usage")
                if not isinstance(usage, dict):
                    continue
                prompt = number(usage.get("input_tokens") or usage.get("prompt_tokens"))
                completion = number(usage.get("output_tokens") or usage.get("completion_tokens"))
                cached = number(usage.get("cache_read_input_tokens") or usage.get("cache_read_tokens"))
                if prompt + completion <= 0:
                    continue
                when = session_when(message.get("timestamp"))
                day = when.date().isoformat() if when else today.isoformat()
                bucket = daily.setdefault(day, {})
                row = bucket.setdefault(model, {"promptTokens": 0, "completionTokens": 0, "cachedTokens": 0, "requests": 0})
                row["promptTokens"] += prompt
                row["completionTokens"] += completion
                row["cachedTokens"] += cached
                row["requests"] += 1
                if when and when.date() == today:
                    hourly[when.hour] += prompt + completion

    def stats_for(start: date | None) -> dict[str, Any]:
        merged: dict[str, dict[str, int]] = {}
        for day, models in daily.items():
            if start is not None and day < start.isoformat():
                continue
            for model, row in models.items():
                target = merged.setdefault(model, {"promptTokens": 0, "completionTokens": 0, "cachedTokens": 0, "requests": 0})
                for field in target:
                    target[field] += row[field]
        return {
            "totalRequests": sum(row["requests"] for row in merged.values()),
            "totalPromptTokens": sum(row["promptTokens"] for row in merged.values()),
            "totalCompletionTokens": sum(row["completionTokens"] for row in merged.values()),
            "totalCachedTokens": sum(row["cachedTokens"] for row in merged.values()),
            "totalCost": 0,
            "byModel": {model: {"rawModel": model, **row} for model, row in merged.items()},
        }

    def chart_for(days: int) -> list[dict[str, Any]]:
        start = today - timedelta(days=days - 1)
        points = []
        for offset in range(days):
            day = start + timedelta(days=offset)
            models = daily.get(day.isoformat()) or {}
            tokens = sum(row["promptTokens"] + row["completionTokens"] for row in models.values())
            points.append({"label": chart_day_label(day), "tokens": tokens, "cost": 0})
        return points

    week_start = today - timedelta(days=6)
    month_start = today - timedelta(days=29)
    return {
        "stats": {
            "all": stats_for(None),
            "30d": stats_for(month_start),
            "7d": stats_for(week_start),
            "today": stats_for(today),
        },
        "charts": {
            "today": [{"label": f"{hour:02d}:00", "tokens": hourly[hour], "cost": 0} for hour in range(24)],
            "7d": chart_for(7),
            "30d": chart_for(30),
        },
    }


def fetch_hostinger() -> dict[str, Any]:
    proc = subprocess.run(
        ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=12", "sennin-kvm",
         "docker", "exec", "-i", "9router", "node"],
        input=HOSTINGER_JS.encode(),
        capture_output=True,
        timeout=70,
    )
    if proc.returncode != 0:
        detail = proc.stderr.decode("utf-8", "replace").strip().splitlines()
        raise RuntimeError(detail[-1] if detail else "ssh do Hostinger falhou")
    payload = json.loads(proc.stdout)
    if not isinstance(payload, dict) or "stats" not in payload:
        raise RuntimeError("resposta do Hostinger sem stats")
    return payload


def dashboard_password(label: str) -> str:
    if label == "Railway":
        return os.environ.get("NINEROUTER_RAILWAY_DASHBOARD_PASSWORD") or ""
    if label == "Sherlocker":
        configured = os.environ.get("NINEROUTER_SHERLOCKER_DASHBOARD_PASSWORD") or ""
        if configured:
            return configured
        try:
            proc = subprocess.run(
                ["cofre", "teiax", "pega", "9router"],
                capture_output=True,
                timeout=180,
            )
        except (OSError, subprocess.TimeoutExpired):
            return ""
        if proc.returncode != 0:
            return ""
        return proc.stdout.decode("utf-8", "replace").strip()
    return ""


def fetch_dashboard(base: str, password: str) -> dict[str, Any]:
    if not password:
        raise RuntimeError("sem senha de painel")
    from urllib.request import Request
    login = Request(
        base + "/api/auth/login",
        data=json.dumps({"password": password}).encode(),
        headers={"Content-Type": "application/json", "Accept": "application/json", "User-Agent": "omarchy-agents"},
    )
    try:
        with urlopen(login, timeout=20) as response:
            cookie = response.headers.get("Set-Cookie") or ""
    except (HTTPError, URLError, TimeoutError) as error:
        code = getattr(error, "code", None)
        raise RuntimeError(f"login HTTP {code}" if code else "login falhou") from error
    if "auth_token=" not in cookie:
        raise RuntimeError("login sem sessão")
    token = cookie.split("auth_token=", 1)[1].split(";", 1)[0]

    def get(path: str) -> Any:
        request = Request(
            base + path,
            headers={"Cookie": "auth_token=" + token, "Accept": "application/json", "User-Agent": "omarchy-agents"},
        )
        with urlopen(request, timeout=30) as response:
            return json.load(response)

    stats = {period: get(f"/api/usage/stats?period={period}") for period in STATS_PERIODS}
    charts = {period: get(f"/api/usage/chart?period={period}") for period in CHART_PERIODS}
    return {"stats": stats, "charts": charts}


def load_gateway_cache() -> dict[str, Any] | None:
    try:
        data = json.loads(gateway_cache_path().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    if not isinstance(data, dict):
        return None
    fetched = float(data.get("fetchedAt") or 0)
    age = time.time() - fetched
    if age < 0 or age > GATEWAY_CACHE_SECONDS:
        return None
    if datetime.fromtimestamp(fetched).date() != datetime.now().date():
        return None
    gateways = data.get("gateways")
    return gateways if isinstance(gateways, dict) else None


def save_gateway_cache(gateways: dict[str, Any]) -> None:
    path = gateway_cache_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    payload = {"fetchedAt": time.time(), "gateways": gateways}
    temporary = path.with_name(path.name + f".{os.getpid()}.tmp")
    try:
        temporary.write_text(json.dumps(payload), encoding="utf-8")
        temporary.chmod(0o600)
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)


def read_gateways(*, force: bool = False) -> tuple[list[tuple[str, dict[str, Any]]], list[tuple[str, str]]]:
    cached = None if force else load_gateway_cache()
    if cached is None:
        cached = {}
        for label, base, kind in GATEWAYS:
            key_error = ""
            try:
                api_key = jcode_api_key(label)
                if api_key:
                    cached[label] = {"ok": True, "payload": fetch_with_jcode_key(base, api_key)}
                    continue
                key_error = "jcode sem chave desse gateway"
            except (RuntimeError, OSError, ValueError) as error:
                key_error = str(error).splitlines()[-1][:180]
            try:
                if kind == "ssh":
                    cached[label] = {"ok": True, "payload": fetch_hostinger()}
                elif label == "Railway":
                    # The usage API refuses the Jcode key. Sessions that key
                    # already wrote are the Railway total this PC can prove.
                    payload = jcode_provider_payload("9router-railway")
                    all_stats = ((payload.get("stats") or {}).get("all") or {})
                    proved = number(all_stats.get("totalPromptTokens")) + number(all_stats.get("totalCompletionTokens"))
                    if proved > 0:
                        payload["ledger"] = "jcode"
                        cached[label] = {"ok": True, "payload": payload}
                    else:
                        cached[label] = {"ok": False, "error": key_error or "jcode deste PC sem uso desse gateway"}
                else:
                    password = dashboard_password(label)
                    if not password:
                        cached[label] = {"ok": False, "error": key_error or "sem senha de painel"}
                        continue
                    cached[label] = {"ok": True, "payload": fetch_dashboard(base, password)}
            except (RuntimeError, OSError, ValueError, subprocess.TimeoutExpired) as error:
                fallback = str(error).splitlines()[-1][:180]
                cached[label] = {"ok": False, "error": key_error or fallback}
        save_gateway_cache(cached)
    payloads: list[tuple[str, dict[str, Any]]] = []
    errors: list[tuple[str, str]] = []
    for label, _base, _kind in GATEWAYS:
        entry = cached.get(label) or {}
        if entry.get("ok") and isinstance(entry.get("payload"), dict):
            payloads.append((label, entry["payload"]))
        else:
            errors.append((label, str(entry.get("error") or "sem leitura")))
    return payloads, errors


def collect_gateways(*, force: bool = False) -> dict[str, Any]:
    payloads, errors = read_gateways(force=force)
    if not payloads:
        stats = collect_db()
        stats["sources"] = list(stats.get("sources") or []) + [
            {"label": label, "available": False, "requests": 0, "tokens": 0, "error": error}
            for label, error in errors
        ]
        return stats
    stats_by_period, charts = combine_gateway_stats(payloads, errors)

    def fetch(path: str, params: dict[str, Any] | None = None) -> Any:
        period = str((params or {}).get("period") or "all")
        if path.endswith("/stats"):
            found = stats_by_period.get(period)
            if not isinstance(found, dict):
                raise RuntimeError(f"período {period} ausente")
            return found
        if path.endswith("/chart"):
            return charts.get(period) or []
        raise RuntimeError(f"rota inesperada {path}")

    stats = collect_api(fetch)
    stats["usageOrigin"] = "gateways"
    # The footer shows this list on every period. All-time is the sum the
    # tab is for; today's slice would hide a gateway that was quiet today.
    stats["sources"] = list(stats_by_period.get("all", {}).get("sources") or stats.get("sources") or [])
    local = [label for label, payload in payloads if payload.get("ledger") == "jcode"]
    if local:
        stats["localLedgers"] = local
    return stats


def collect(path: Path | None = None, fetch=api_json, *, force: bool = False) -> dict[str, Any]:
    if path is not None:
        return collect_db(path)
    # Tests inject a fetch. The three live gateways are only for the real CLI.
    if fetch is not api_json:
        try:
            return collect_api(fetch)
        except RuntimeError:
            return collect_db()
    return collect_gateways(force=force)


def status_line(stats: dict[str, Any]) -> str:
    today_cost = float(stats.get("todayCost") or 0)
    total_cost = float(stats.get("totalCost") or 0)
    if today_cost > 0:
        text = f"US$ {today_cost:.2f} spent today"
    elif total_cost > 0:
        text = f"US$ {total_cost:.2f} recorded"
    else:
        text = ""
    newest = ""
    for row in stats.get("history") or []:
        if isinstance(row, dict):
            newest = max(newest, str(row.get("date") or ""))
    today = datetime.now().astimezone().date().isoformat()
    if newest and newest < today and stats.get("usageOrigin") == "local-db":
        text = (text + f" · ledger local até {newest}").strip(" ·")
    blocked = [
        str(source.get("label"))
        for source in stats.get("sources") or []
        if isinstance(source, dict) and source.get("available") is False and source.get("label")
    ]
    if blocked:
        text = (text + " · " + ", ".join(blocked) + " sem acesso").strip(" ·")
    local = [str(label) for label in (stats.get("localLedgers") or []) if label]
    if local:
        text = (text + " · " + ", ".join(local) + " pelo jcode deste PC").strip(" ·")
    return text

def source_status(stats: dict[str, Any]) -> str:
    available = [str(source.get("label")) for source in stats.get("sources", []) if source.get("available")]
    return " + ".join(label for label in available if label)


def main() -> int:
    parser = argparse.ArgumentParser(description="Print the 9Router usage record as JSON")
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--limits-only", action="store_true")
    args = parser.parse_args()

    stats = collect(force=args.force)
    ready = stats["totalPrompts"] > 0 or stats["totalSessions"] > 0 or bool(stats["modelUsage"])
    record = {
        "schemaVersion": 1,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "updatedAt": datetime.now(timezone.utc).isoformat(),
        "ready": ready,
        "tierLabel": source_status(stats) or "Gateway",
        "usageStatusText": status_line(stats),
        "authHelpText": "" if db_path().is_file() else "9Router is not running on this machine.",
        "limits": [],
        "scope": "device",
    }
    record.update(stats)
    json.dump(record, sys.stdout, separators=(",", ":"), sort_keys=True)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
